# Gmail SMTP for registration/login verification codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-new-google-app-password
SMTP_FROM_NAME=FinMind Support

# Random secret used to hash OTPs. Generate locally with:
# openssl rand -hex 32
OTP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Existing required application settings (set these locally; never commit real values)
DATABASE_URL=postgresql://user:password@localhost:5432/finmind
JWT_PRIVATE_KEY=replace-with-your-jwt-private-key
JWT_PUBLIC_KEY=replace-with-your-jwt-public-key
